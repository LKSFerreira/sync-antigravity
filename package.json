{
  "name": "sync-antigravity",
  "displayName": "%extensao.nome%",
  "description": "%extensao.descricao%",
  "version": "0.8.0",
  "publisher": "lksferreira",
  "author": {
    "name": "LKSFerreira"
  },
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LKSFerreira/sync-antigravity.git"
  },
  "bugs": {
    "url": "https://github.com/LKSFerreira/sync-antigravity/issues"
  },
  "homepage": "https://github.com/LKSFerreira/sync-antigravity#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sync",
    "settings",
    "extensions",
    "keybindings",
    "snippets",
    "google-drive",
    "profile",
    "antigravity"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "antigravitysync.showDashboard",
        "title": "%comando.abrirPainel.titulo%",
        "category": "%extensao.nome%"
      },
      {
        "command": "antigravitysync.rollbackLayout",
        "title": "%comando.reverterLayout.titulo%",
        "category": "%extensao.nome%"
      }
    ],
    "configuration": {
      "title": "%extensao.nome%",
      "properties": {
        "antigravitysync.excludeExtensions": {
          "type": "array",
          "default": [],
          "description": "%configuracao.extensoesExcluidas.descricao%"
        }
      }
    }
  },
  "scripts": {
    "compile": "webpack",
    "compile:tsc": "tsc -p ./",
    "compile:test": "tsc -p tsconfig.test.json",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src",
    "l10n:sync-pt": "node scripts/sincronizar-localizacao-portugues.cjs",
    "l10n:check": "node scripts/validar-localizacao.cjs",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "package:vsix": "npm run l10n:check && npm run package && vsce package --out artifacts/sync-antigravity.vsix",
    "openvsx:create-namespace": "ovsx create-namespace lksferreira",
    "test:unit": "npm run compile:test && node --test out/test/profile-validator.test.js out/test/layout-profile.test.js out/test/installed-extensions.test.js out/test/localizacao.test.js test/localizacao-webview.test.cjs",
    "test:integration": "npm run compile:test && node --test out/test/layout-state-database.test.js out/test/layout-replacement-helper.test.js",
    "test": "npm run compile:test && c8 --all --check-coverage --lines 95 --functions 95 --branches 90 --statements 95 --include=out/src/core/erro-da-extensao.js --include=out/src/core/profile-validator.js --include=out/src/models/layout-profile.js --include=out/src/core/layout-state-database.js --include=out/src/core/installed-extensions.js --include=out/src/localizacao/idioma.js --include=out/src/localizacao/serializacao-webview.js --include=src/core/layout-replacement-helper.js --include=src/webview/localizacao.js node --test out/test/profile-validator.test.js out/test/layout-profile.test.js out/test/layout-state-database.test.js out/test/layout-replacement-helper.test.js out/test/installed-extensions.test.js out/test/localizacao.test.js test/localizacao-webview.test.cjs"
  },
  "devDependencies": {
    "@types/node": "20.19.37",
    "@types/sql.js": "1.4.11",
    "@types/vscode": "1.90.0",
    "@vscode/codicons": "0.0.36",
    "@vscode/l10n-dev": "0.0.35",
    "@vscode/vsce": "4.0.0",
    "c8": "12.0.0",
    "copy-webpack-plugin": "14.0.0",
    "dotenv": "17.3.1",
    "ovsx": "1.2.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "webpack": "5.105.4",
    "webpack-cli": "6.0.1"
  },
  "dependencies": {
    "sql.js": "1.14.2"
  },
  "overrides": {
    "@vscode/vsce": "4.0.0"
  }
}
