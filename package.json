{
    "name": "sync-antigravity",
    "displayName": "Sync Antigravity",
    "description": "Sincronize configurações, extensões, atalhos, snippets e layout do Antigravity entre dispositivos usando o Google Drive",
    "version": "0.7.4",
    "publisher": "lksferreira",
    "author": {
        "name": "LKSFerreira"
    },
    "icon": "images/icon.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/LKSFerreira/sync-antigravity.git"
    },
    "bugs": {
        "url": "https://github.com/LKSFerreira/sync-antigravity/issues"
    },
    "homepage": "https://github.com/LKSFerreira/sync-antigravity#readme",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "sync",
        "settings",
        "extensions",
        "keybindings",
        "snippets",
        "google-drive",
        "profile",
        "antigravity"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "antigravitysync.showDashboard",
                "title": "Abrir painel",
                "category": "Sync Antigravity"
            },
            {
                "command": "antigravitysync.rollbackLayout",
                "title": "Reverter último layout",
                "category": "Sync Antigravity"
            }
        ],
        "configuration": {
            "title": "Sync Antigravity",
            "properties": {
                "antigravitysync.excludeExtensions": {
                    "type": "array",
                    "default": [],
                    "description": "IDs de extensões a excluir da sincronização"
                }
            }
        }
    },
    "scripts": {
        "compile": "webpack",
        "compile:tsc": "tsc -p ./",
        "compile:test": "tsc -p tsconfig.test.json",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "test:unit": "npm run compile:test && node --test out/test/profile-validator.test.js out/test/layout-profile.test.js",
        "test:integration": "npm run compile:test && node --test out/test/layout-state-database.test.js",
        "test": "npm run compile:test && c8 --all --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 --include=out/src/core/profile-validator.js --include=out/src/models/layout-profile.js --include=out/src/core/layout-state-database.js node --test out/test/profile-validator.test.js out/test/layout-profile.test.js out/test/layout-state-database.test.js"
    },
    "devDependencies": {
        "@types/node": "20.19.37",
        "@types/sql.js": "1.4.11",
        "@types/vscode": "1.90.0",
        "@vscode/codicons": "0.0.36",
        "@vscode/vsce": "3.9.2",
        "c8": "12.0.0",
        "copy-webpack-plugin": "14.0.0",
        "dotenv": "17.3.1",
        "ts-loader": "9.5.4",
        "typescript": "5.9.3",
        "webpack": "5.105.4",
        "webpack-cli": "6.0.1"
    },
    "dependencies": {
        "sql.js": "1.14.2"
    }
}
